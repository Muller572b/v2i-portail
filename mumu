<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>V2I Portail - Espace Opticien</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght=300;400;500;600;700&display=swap');
        body { 
            font-family: 'Inter', sans-serif; 
            letter-spacing: -0.01em;
        }
    </style>
</head>
<body class="bg-[#f5f5f7] min-h-screen text-[#1d1d1f] antialiased">

    <div id="login-screen" class="flex min-h-screen items-center justify-center px-4">
        <div class="w-full max-w-md bg-white/80 backdrop-blur-md rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.05)] border border-white/40 p-8 transition-all duration-500">
            <div class="flex flex-col items-center mb-10">
                <div class="bg-[#0066cc]/10 text-[#0066cc] p-3.5 rounded-2xl mb-4">
                    <i data-lucide="shield" class="w-7 h-7 stroke-[1.5]"></i>
                </div>
                <h1 class="text-2xl font-semibold tracking-tight text-[#1d1d1f]">Portail Partenaires V2I</h1>
                <p class="text-sm text-[#86868b] mt-1.5">Connectez-vous à votre espace optique</p>
            </div>
            
            <form onsubmit="handleLogin(event)" class="space-y-6">
                <div>
                    <label class="block text-xs font-medium text-[#86868b] mb-2 tracking-normal">Identifiant Magasin (Code Client Lensware)</label>
                    <input type="text" id="username" required placeholder="ex: 10204" 
                           class="w-full px-4 py-3 bg-[#f5f5f7] border border-transparent rounded-xl focus:outline-none focus:border-[#0066cc] focus:bg-white transition-all text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-[#86868b] mb-2 tracking-normal">Mot de passe</label>
                    <input type="password" id="password" required placeholder="••••••••" 
                           class="w-full px-4 py-3 bg-[#f5f5f7] border border-transparent rounded-xl focus:outline-none focus:border-[#0066cc] focus:bg-white transition-all text-sm">
                </div>
                <button type="submit" id="login-btn" class="w-full bg-[#0066cc] text-white font-medium py-3 rounded-xl hover:bg-[#0077ed] active:scale-[0.99] transition-all flex items-center justify-center gap-2 cursor-pointer text-sm shadow-sm">
                    <span id="btn-text">Se connecter</span> <i data-lucide="chevron-right" class="w-4 h-4"></i>
                </button>
            </form>
            <p id="login-error" class="text-[#ff3b30] text-sm text-center mt-4 hidden font-medium">Identifiants incorrects ou magasin introuvable.</p>
        </div>
    </div>

    <div id="main-interface" class="hidden">
        <nav class="bg-white/80 backdrop-blur-md border-b border-[#e8e8ed] sticky top-0 z-50">
            <div class="max-w-6xl mx-auto px-6">
                <div class="flex justify-between h-14 items-center">
                    <div class="flex items-center gap-3">
                        <span class="font-semibold text-base tracking-tight">V2I Optique</span>
                        <span id="store-badge" class="bg-[#f5f5f7] text-[#86868b] text-xs px-2.5 py-1 rounded-full font-medium border border-[#e8e8ed]">Magasin : ---</span>
                    </div>
                    
                    <div class="hidden md:flex items-center h-full space-x-1">
                        <button onclick="switchTab('verres')" id="tab-verres" class="tab-btn px-4 h-14 text-sm font-medium border-b-2 border-transparent text-[#86868b] hover:text-[#1d1d1f] flex items-center gap-2 cursor-pointer transition-all">
                            <i data-lucide="activity" class="w-4 h-4 stroke-[1.5]"></i> Suivi de commande Verres
                        </button>
                        <button onclick="switchTab('calcul')" id="tab-calcul" class="tab-btn px-4 h-14 text-sm font-medium border-b-2 border-transparent text-[#86868b] hover:text-[#1d1d1f] flex items-center gap-2 cursor-pointer transition-all">
                            <i data-lucide="layers" class="w-4 h-4 stroke-[1.5]"></i> Calcul Verre
                        </button>
                        <button onclick="switchTab('monture')" id="tab-monture" class="tab-btn px-4 h-14 text-sm font-medium border-b-2 border-transparent text-[#86868b] hover:text-[#1d1d1f] flex items-center gap-2 cursor-pointer transition-all">
                            <i data-lucide="glasses" class="w-4 h-4 stroke-[1.5]"></i> Monture
                        </button>
                        <button onclick="switchTab('documents')" id="tab-documents" class="tab-btn px-4 h-14 text-sm font-medium border-b-2 border-transparent text-[#86868b] hover:text-[#1d1d1f] flex items-center gap-2 cursor-pointer transition-all">
                            <i data-lucide="file-text" class="w-4 h-4 stroke-[1.5]"></i> Documents
                        </button>
                    </div>

                    <button onclick="logout()" class="text-[#86868b] hover:text-[#ff3b30] transition-colors flex items-center gap-1.5 text-xs font-medium cursor-pointer">
                        Déconnexion <i data-lucide="log-out" class="w-3.5 h-3.5"></i>
                    </button>
                </div>
            </div>
        </nav>

        <div class="max-w-6xl mx-auto px-6 py-10">
            
            <div id="content-welcome" class="space-y-10 animate-fade-in">
                <div class="max-w-2xl">
                    <h2 class="text-4xl font-semibold tracking-tight text-[#1d1d1f]">Bonjour, <span id="welcome-store-name">Magasin</span></h2>
                    <p class="text-xl text-[#86868b] mt-2 font-normal leading-relaxed">Bienvenue sur votre espace de gestion haute précision. Sélectionnez un outil ci-dessus ou parcourez vos accès rapides.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <div onclick="switchTab('verres')" class="bg-white p-6 rounded-2xl border border-[#e8e8ed] shadow-sm hover:shadow-md transition-all cursor-pointer group">
                        <div class="w-10 h-10 bg-[#0066cc]/5 text-[#0066cc] rounded-xl flex items-center justify-center mb-4 group-hover:bg-[#0066cc] group-hover:text-white transition-all">
                            <i data-lucide="activity" class="w-5 h-5 stroke-[1.5]"></i>
                        </div>
                        <h3 class="font-semibold text-base mb-1">Suivi Verres</h3>
                        <p class="text-xs text-[#86868b]">Consultez vos délais et étapes de fabrication Lensware en direct.</p>
                    </div>

                    <div onclick="switchTab('calcul')" class="bg-white p-6 rounded-2xl border border-[#e8e8ed] shadow-sm hover:shadow-md transition-all cursor-pointer group">
                        <div class="w-10 h-10 bg-[#5856d6]/5 text-[#5856d6] rounded-xl flex items-center justify-center mb-4 group-hover:bg-[#5856d6] group-hover:text-white transition-all">
                            <i data-lucide="layers" class="w-5 h-5 stroke-[1.5]"></i>
                        </div>
                        <h3 class="font-semibold text-base mb-1">Calcul Verre</h3>
                        <p class="text-xs text-[#86868b]">Simulateur technique d'épaisseur et de précalibrage.</p>
                    </div>

                    <div onclick="switchTab('monture')" class="bg-white p-6 rounded-2xl border border-[#e8e8ed] shadow-sm hover:shadow-md transition-all cursor-pointer group">
                        <div class="w-10 h-10 bg-[#ff9500]/5 text-[#ff9500] rounded-xl flex items-center justify-center mb-4 group-hover:bg-[#ff9500] group-hover:text-white transition-all">
                            <i data-lucide="glasses" class="w-5 h-5 stroke-[1.5]"></i>
                        </div>
                        <h3 class="font-semibold text-base mb-1">Catalogue Montures</h3>
                        <p class="text-xs text-[#86868b]">Vérification instantanée des stocks labo et magasin.</p>
                    </div>

                    <div onclick="switchTab('documents')" class="bg-white p-6 rounded-2xl border border-[#e8e8ed] shadow-sm hover:shadow-md transition-all cursor-pointer group">
                        <div class="w-10 h-10 bg-[#34c759]/5 text-[#34c759] rounded-xl flex items-center justify-center mb-4 group-hover:bg-[#34c759] group-hover:text-white transition-all">
                            <i data-lucide="file-text" class="w-5 h-5 stroke-[1.5]"></i>
                        </div>
                        <h3 class="font-semibold text-base mb-1">Documents</h3>
                        <p class="text-xs text-[#86868b]">Téléchargez vos Factures-X, tarifs et catalogues.</p>
                    </div>
                </div>
            </div>

            <div id="content-verres" class="tab-content hidden space-y-6">
                <div class="flex flex-col md:flex-row gap-4 items-center justify-between bg-white p-4 rounded-2xl border border-[#e8e8ed]">
                    <div class="relative w-full md:max-w-md">
                        <i data-lucide="search" class="w-4 h-4 text-[#86868b] absolute left-3.5 top-3"></i>
                        <input type="text" id="search-verres" oninput="renderVerres()" placeholder="Rechercher un patient ou un n° de commande..." 
                               class="w-full pl-10 pr-4 py-2 bg-[#f5f5f7] border border-transparent rounded-xl focus:outline-none focus:border-[#0066cc] focus:bg-white transition-all text-sm">
                    </div>
                </div>
                <div class="bg-white rounded-2xl border border-[#e8e8ed] overflow-hidden shadow-sm">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="bg-[#f5f5f7] text-[#86868b] font-medium text-xs border-b border-[#e8e8ed]">
                                <th class="px-6 py-3">Patient / Commande</th>
                                <th class="px-6 py-3">Détails de Production</th>
                                <th class="px-6 py-3">Statut Délai KPI</th>
                                <th class="px-6 py-3 text-right">Document</th>
                            </tr>
                        </thead>
                        <tbody id="verres-table-body" class="divide-y divide-[#e8e8ed] text-[#1d1d1f]">
                            </tbody>
                    </table>
                    <div id="no-orders-message" class="p-12 text-center text-[#86868b] hidden">Aucune commande en cours de fabrication pour ce magasin.</div>
                </div>
            </div>

            <div id="content-calcul" class="tab-content hidden max-w-xl mx-auto">
                <div class="bg-white p-8 rounded-3xl border border-[#e8e8ed] shadow-sm space-y-6">
                    <div class="text-center">
                        <h2 class="text-xl font-semibold tracking-tight">Calculateur d'Épaisseur Index</h2>
                        <p class="text-sm text-[#86868b] mt-1">Outil d'atelier pour le précalibrage</p>
                    </div>
                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-medium text-[#86868b] mb-1.5">Puissance Sphérique (Dioptries)</label>
                            <input type="number" id="calc-sphere" value="-4.00" step="0.25" oninput="runCalculation()" class="w-full px-4 py-2.5 bg-[#f5f5f7] border border-transparent rounded-xl focus:outline-none focus:border-[#0066cc] focus:bg-white transition-all">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-[#86868b] mb-1.5">Diamètre du verre (mm)</label>
                            <input type="number" id="calc-diam" value="70" oninput="runCalculation()" class="w-full px-4 py-2.5 bg-[#f5f5f7] border border-transparent rounded-xl focus:outline-none focus:border-[#0066cc] focus:bg-white transition-all">
                        </div>
                    </div>
                    <div class="bg-[#0066cc]/5 rounded-2xl p-6 text-center border border-[#0066cc]/10">
                        <span class="text-xs font-semibold uppercase tracking-wider text-[#0066cc]">Épaisseur au bord estimée</span>
                        <div class="text-4xl font-bold mt-1 text-[#1d1d1f]"><span id="calc-result">3.20</span> <span class="text-lg font-medium">mm</span></div>
                    </div>
                </div>
            </div>

            <div id="content-monture" class="tab-content hidden space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6" id="montures-grid">
                    </div>
            </div>

            <div id="content-documents" class="tab-content hidden max-w-3xl mx-auto space-y-4">
                <div class="bg-white rounded-2xl border border-[#e8e8ed] p-6">
                    <h2 class="text-base font-semibold mb-4">Vos Factures-X & Catalogues</h2>
                    <div id="docs-list" class="space-y-3"></div>
                </div>
            </div>

        </div>
    </div>

    <script>
        // --- LIEN VERS LE FICHIER RAW GITHUB GENERÉ PAR PYTHON ---
        const GITHUB_JSON_URL = "https://raw.githubusercontent.com/Muller572b/v2i-portail/main/suivi_magasins.json";
        
        let currentStoreData = null;

        async function handleLogin(e) {
            e.preventDefault();
            const usernameInput = document.getElementById('username').value.trim().toLowerCase();
            const errorEl = document.getElementById('login-error');
            const loginBtn = document.getElementById('login-btn');
            const btnText = document.getElementById('btn-text');
            
            errorEl.classList.add('hidden');
            loginBtn.disabled = true;
            btnText.innerText = "Téléchargement des flux...";

            try {
                // 1. Récupération directe depuis GitHub Raw (Évite les blocages IONOS)
                const response = await fetch(GITHUB_JSON_URL);
                if (!response.ok) throw new Error("Serveur de données distant indisponible.");
                
                const dataGlobal = await response.json();
                
                // 2. Filtrage cloisonné : l'opticien accède uniquement à sa clé "CustNumb"
                if (dataGlobal && dataGlobal[usernameInput]) {
                    const storeObj = dataGlobal[usernameInput];
                    
                    currentStoreData = {
                        storeName: storeObj.nom_magasin || usernameInput.toUpperCase(),
                        verres: storeObj.commandes_verres || [],
                        montures: [
                            { model: 'Banana Gold - Aviator', ref: 'BN-2026-X', detail: 'Or Jaune Satiné / Branches titane', stock: 'Stock central : 12 | Magasin : 1', img: 'https://images.unsplash.com/photo-1572635196237-14b3f281503f?auto=format&fit=crop&w=300&q=80' }
                        ],
                        docs: storeObj.documents || [
                            { name: 'Catalogue Général Tarifs V2I 2026.pdf', type: 'Tarif Technique', size: '4.8 Mo' }
                        ]
                    };

                    // 3. Changement d'écran d'affichage
                    document.getElementById('login-screen').classList.add('hidden');
                    document.getElementById('main-interface').classList.remove('hidden');
                    document.getElementById('store-badge').innerText = "Magasin : " + currentStoreData.storeName;
                    document.getElementById('welcome-store-name').innerText = currentStoreData.storeName;

                    // 4. Génération de l'encours du client connecté
                    renderVerres();
                    renderMontures();
                    renderDocs();
                    lucide.createIcons();
                } else {
                    errorEl.innerText = "Identifiant magasin incorrect ou aucune commande en cours.";
                    errorEl.classList.remove('hidden');
                }
            } catch (error) {
                console.error(error);
                errorEl.innerText = "Erreur réseau : Impossible de synchroniser les flux avec GitHub.";
                errorEl.classList.remove('hidden');
            } finally {
                loginBtn.disabled = false;
                btnText.innerText = "Se connecter";
            }
        }

        function switchTab(tabId) {
            document.getElementById('content-welcome').classList.add('hidden');
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.className = "tab-btn px-4 h-14 text-sm font-medium border-b-2 border-transparent text-[#86868b] hover:text-[#1d1d1f] flex items-center gap-2 cursor-pointer transition-all";
            });

            document.getElementById('content-' + tabId).classList.remove('hidden');
            document.getElementById('tab-' + tabId).className = "tab-btn px-4 h-14 text-sm font-medium border-b-2 border-[#0066cc] text-[#0066cc] flex items-center gap-2 cursor-pointer transition-all";
        }

        function renderVerres() {
            const tbody = document.getElementById('verres-table-body');
            const noOrdersEl = document.getElementById('no-orders-message');
            tbody.innerHTML = '';
            
            if (!currentStoreData || currentStoreData.verres.length === 0) {
                noOrdersEl.classList.remove('hidden');
                return;
            }
            
            noOrdersEl.classList.add('hidden');
            const search = document.getElementById('search-verres').value.toLowerCase();

            currentStoreData.verres.forEach(v => {
                // Filtre de recherche dynamique par patient ou numéro de commande
                if(search && !v.patient.toLowerCase().includes(search) && !v.id_commande.toLowerCase().includes(search)) return;
                
                tbody.innerHTML += `
                    <tr class="hover:bg-[#f5f5f7]/50 transition-colors">
                        <td class="px-6 py-4">
                            <div class="font-medium text-[#1d1d1f]">${v.patient}</div>
                            <div class="text-xs text-[#86868b]">N° ${v.id_commande}</div>
                        </td>
                        <td class="px-6 py-4 text-[#86868b] font-normal max-w-xs md:max-w-md truncate">${v.detail}</td>
                        <td class="px-6 py-4">
                            <span class="px-2.5 py-1 text-xs font-medium rounded-full border ${v.style_couleur}">
                                ${v.statut}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <button class="text-[#0066cc] hover:underline text-xs font-medium cursor-pointer">Factur-X (PDF)</button>
                        </td>
                    </tr>
                `;
            });
        }

        function renderMontures() {
            const grid = document.getElementById('montures-grid');
            grid.innerHTML = '';
            if(!currentStoreData) return;
            
            currentStoreData.montures.forEach(m => {
                grid.innerHTML += `
                    <div class="bg-white rounded-2xl border border-[#e8e8ed] overflow-hidden shadow-sm hover:shadow-md transition-all">
                        <img src="${m.img}" class="w-full h-44 object-cover border-b border-[#e8e8ed]" alt="">
                        <div class="p-5 space-y-2">
                            <div>
                                <h4 class="font-semibold text-base">${m.model}</h4>
                                <p class="text-xs text-[#86868b]">${m.ref} • ${m.detail}</p>
                            </div>
                            <div class="text-xs bg-[#f5f5f7] p-2 rounded-lg text-[#1d1d1f] font-medium">${m.stock}</div>
                        </div>
                    </div>
                `;
            });
        }

        function renderDocs() {
            const container = document.getElementById('docs-list');
            container.innerHTML = '';
            if(!currentStoreData) return;
            
            currentStoreData.docs.forEach(d => {
                container.innerHTML += `
                    <div class="flex items-center justify-between p-3 bg-[#f5f5f7] rounded-xl border border-transparent hover:border-[#e8e8ed] transition-all">
                        <div class="flex items-center gap-3">
                            <i data-lucide="file" class="w-4 h-4 text-[#86868b]"></i>
                            <div>
                                <p class="text-sm font-medium">${d.name}</p>
                                <p class="text-xs text-[#86868b]">${d.type} • ${d.size}</p>
                            </div>
                        </div>
                        <button class="text-[#0066cc] hover:text-[#0055bb] text-sm"><i data-lucide="download" class="w-4 h-4"></i></button>
                    </div>
                `;
            });
        }

        function runCalculation() {
            const sphere = Math.abs(parseFloat(document.getElementById('calc-sphere').value)) || 0;
            const diam = parseFloat(document.getElementById('calc-diam').value) || 0;
            const result = 1.5 + (sphere * (diam / 100));
            document.getElementById('calc-result').innerText = result.toFixed(2);
        }

        function logout() {
            currentStoreData = null;
            document.getElementById('username').value = '';
            document.getElementById('password').value = '';
            document.getElementById('main-interface').classList.add('hidden');
            document.getElementById('login-screen').classList.remove('hidden');
            document.getElementById('content-welcome').classList.remove('hidden');
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
        }
    </script>
</body>
</html>
